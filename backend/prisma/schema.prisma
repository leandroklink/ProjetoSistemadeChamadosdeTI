generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chamado {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  categoria    String
  prioridade   String
  status       String   @default("ABERTO")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("chamados")
}